# Required
DATABASE_URL=postgres://postgres@localhost:5432/snacker   # Neon pooled URL in production (injected by the Vercel integration)
BETTER_AUTH_SECRET=change-me-openssl-rand-base64-32        # openssl rand -base64 32
# Optional
BETTER_AUTH_URL=http://localhost:3000                       # canonical origin; previews fall back to VERCEL_URL
ANTHROPIC_API_KEY=                                          # recipe extraction, ingredient matching, receipts (M1+)
BLOB_READ_WRITE_TOKEN=                                      # photo/PDF uploads (M4)
LOCAL=1                                                     # lets scripts/migrate.ts run outside Vercel production
