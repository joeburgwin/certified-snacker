{
  "name": "certified-snacker",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/migrate.ts && next build",
    "start": "next start",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check": "biome check . && next typegen && tsc --noEmit && vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "LOCAL=1 tsx scripts/migrate.ts",
    "db:local": "bash scripts/db-local.sh",
    "seed": "LOCAL=1 tsx scripts/seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@better-auth/drizzle-adapter": "1.7.13",
    "@vercel/functions": "3.10.3",
    "better-auth": "1.7.13",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.61.0",
    "motion": "14.6.0",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@fontsource-variable/inter": "5.3.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.9",
    "drizzle-kit": "0.31.11",
    "exceljs": "4.4.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
